// Datos de la aplicación para el destino Runner.

// Nombre de la aplicación. Es también el nombre del paquete .app y el que aparece en la barra
// de menús, donde macOS recorta los nombres largos; por eso se usa la forma corta. El nombre
// completo va en CFBundleDisplayName, dentro de Info.plist.
PRODUCT_NAME = Mis gastos

// Identificador del paquete. En Android se usa com.axchisan.calculadora_gastos, pero macOS no
// admite guiones bajos en el identificador.
PRODUCT_BUNDLE_IDENTIFIER = com.axchisan.calculadoraGastos

// Aviso de derechos que se muestra en la información de la aplicación.
PRODUCT_COPYRIGHT = Copyright © 2026 Duvan Chisan. Todos los derechos reservados.
